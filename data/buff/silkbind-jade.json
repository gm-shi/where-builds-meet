{
  "FloatingUmbrella": {
    "name": "Floating Umbrella",
    "shortName": "Float",
    "showCoverage": true,
    "description": "Unfading Flower's floating umbrella fires every 0.5 seconds, first 0.55 seconds after the throw, and each shot spends 5 Blossoms. While the target carries Lingering Bone, each volley fires one extra shot 0.15 seconds later that also spends 5 Blossoms. It ends when fewer than 5 Blossoms remain, or when another umbrella skill other than Hidden Sword recalls it; ending returns 15 Blossoms at most once every 5 seconds.",
    "maxStack": 1,
    "refresh": true,
    "periodic": {
      "interval": 0.5,
      "firstTick": 0.55,
      "resetOnRefresh": true,
      "action": [
        {
          "type": "trigger",
          "value": "FloatingUmbrellaShot",
          "requirement": [{ "target": "resource", "value": "Blossoms", "comparison": ">=", "amount": 5 }]
        },
        {
          "type": "consumeResource",
          "value": "Blossoms",
          "amount": 5,
          "requirement": [{ "target": "resource", "value": "Blossoms", "comparison": ">=", "amount": 5 }]
        },
        {
          "type": "trigger",
          "value": "FloatingUmbrellaExtraShot",
          "requirement": [
            { "target": "target", "value": "LingeringBone" },
            { "target": "resource", "value": "Blossoms", "comparison": ">=", "amount": 5 }
          ]
        },
        {
          "type": "consumeResource",
          "value": "Blossoms",
          "amount": 5,
          "requirement": [
            { "target": "target", "value": "LingeringBone" },
            { "target": "resource", "value": "Blossoms", "comparison": ">=", "amount": 5 }
          ]
        },
        {
          "type": "trigger",
          "value": "FloatingUmbrellaRecall",
          "requirement": [{ "target": "resource", "value": "Blossoms", "comparison": "<", "amount": 5 }]
        }
      ]
    },
    "trigger": {
      "event": "skillStart",
      "requirement": [
        { "target": "skillTag", "value": "Umbrella" },
        { "operator": "not", "operand": [{ "target": "skillTag", "value": "Triggered" }] },
        { "operator": "not", "operand": [{ "target": "skillTag", "value": "HiddenSword" }] }
      ],
      "action": { "type": "trigger", "value": "FloatingUmbrellaRecall" }
    }
  },
  "FloatingUmbrellaReturnCooldown": {
    "name": "Floating Umbrella Return Cooldown",
    "hidden": true,
    "description": "The floating umbrella's 15 Blossom return on ending is available again when this expires.",
    "duration": 5,
    "maxStack": 1,
    "refresh": false
  },
